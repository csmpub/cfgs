# eza: a modern replacement for ls
alias els='eza --icons --group-directories-first'
alias el='eza -F --icons --group-directories-first'
alias ela='eza -a --icons --group-directories-first'
alias ell='eza -aalbh@HF --icons --time-style="+%y/%m/%d %H:%M" --total-size --git --git-repos'
alias elt='eza -albh@ --no-user --no-time --total-size --git --git-repos --tree --level=4 -I=.git'
